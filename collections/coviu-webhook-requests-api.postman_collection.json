            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"createdAt\": \"<number>\",\n  \"payload\": {\n    \"teamId\": \"<uuid>\",\n    \"callId\": \"<uuid>\",\n    \"waitingQueueId\": \"<uuid>\"\n  },\n  \"type\": \"waitingarea:join\"\n}",
