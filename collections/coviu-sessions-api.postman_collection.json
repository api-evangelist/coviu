                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"session_name\": \"<string>\",\n  \"start_time\": \"<dateTime>\",\n  \"end_time\": \"<dateTime>\",\n  \"actual_end_time\": \"<dateTime>\",\n  \"picture\": \"<string>\",\n  \"participants\": [\n    {\n      \"client_id\": \"<uuid>\",\n      \"display_name\": \"<uuid>\",\n      \"participant_id\": \"<uuid>\",\n      \"role\": \"HOST\",\n      \"session_id\": \"<uuid>\",\n      \"entry_url\": \"<uuid>\",\n      \"picture\": \"<uuid>\",\n      \"state\": \"<string>\",\n      \"user_hint\": \"<string>\",\n      \"deleted_at\": \"<dateTime>\",\n      \"coviu_user_id\": \"<uuid>\",\n      \"phone\": \"<string>\"\n    },\n    {\n      \"client_id\": \"<uuid>\",\n      \"display_name\": \"<uuid>\",\n      \"participant_id\": \"<uuid>\",\n      \"role\": \"HOST\",\n      \"session_id\": \"<uuid>\",\n      \"entry_url\": \"<uuid>\",\n      \"picture\": \"<uuid>\",\n      \"state\": \"<string>\",\n      \"user_hint\": \"<string>\",\n      \"deleted_at\": \"<dateTime>\",\n      \"coviu_user_id\": \"<uuid>\",\n      \"phone\": \"<string>\"\n    }\n  ]\n}",
